<view class="login-page">
  <view class="brand">SmartCustomerBot</view>
  <view class="hint">微信授权登录后即可使用智能客服与自助服务</view>

  <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
    <text class="avatar-tip">点击设置头像</text>
  </button>

  <view class="field">
    <text class="label">昵称</text>
    <input class="input" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNick"></input>
  </view>

  <view class="field">
    <text class="label">手机号（选填，注册完善）</text>
    <input class="input" type="number" maxlength="11" placeholder="便于订单关联" value="{{phone}}" bindinput="onPhone" />
  </view>

  <button class="primary" type="primary" loading="{{loading}}" bindtap="onLogin">微信登录 / 注册</button>
  <view class="legal">登录即表示同意《用户服务协议》与《隐私政策》</view>
</view>
