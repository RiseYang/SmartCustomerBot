.login-page {
  padding: 64rpx 48rpx;
  min-height: 100vh;
  background: #fff;
  box-sizing: border-box;
}
.brand {
  font-size: 44rpx;
  font-weight: 700;
  color: #07c160;
}
.hint {
  font-size: 26rpx;
  color: #888;
  margin: 16rpx 0 48rpx;
}
.avatar-wrapper {
  background: transparent;
  padding: 0;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: normal;
}
.avatar-wrapper::after {
  border: none;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.avatar-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  background: #f5f5f5;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.primary {
  margin-top: 32rpx;
  border-radius: 999rpx;
}
.legal {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}
