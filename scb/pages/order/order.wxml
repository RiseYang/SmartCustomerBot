<view class="biz-page">
  <view class="search-bar">
    <input class="search" placeholder="订单号 / 商品名" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" />
    <button size="mini" type="primary" bindtap="search">查询</button>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{!list.length}}" class="tip">暂无订单</view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row">
      <text class="oid">{{item.id}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="title">{{item.title}}</view>
    <view class="meta">¥{{item.amount}} · {{item.createdAt}}</view>
    <view class="actions">
      <button size="mini" data-id="{{item.id}}" bindtap="goLogistics">查物流</button>
      <button size="mini" data-id="{{item.id}}" bindtap="goInvoice">开发票</button>
    </view>
  </view>
</view>
