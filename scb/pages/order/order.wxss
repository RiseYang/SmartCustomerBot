.biz-page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search {
  flex: 1;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #888;
}
.status {
  color: #07c160;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}
.meta {
  font-size: 26rpx;
  color: #666;
}
.actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
