.mine-page {
  min-height: 100vh;
  background: #f6f7f9;
}
.profile {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #07c160, #06ae56);
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}
.name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}
.menu {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.menu-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
.logout {
  margin: 48rpx 32rpx;
  background: #fff;
  color: #e64340;
  border-radius: 12rpx;
}
.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}
.detail-top {
  z-index: 21;
}
.detail-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 36rpx 32rpx 56rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}
.list-sheet {
  max-height: 78vh;
  overflow-y: auto;
}
.rating-list {
  border-top: 1rpx solid #f0f0f0;
}
.rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.rating-row-main {
  min-width: 0;
  flex: 1;
}
.rating-row-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}
.rating-row-preview {
  overflow: hidden;
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rating-row-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rating-row-time {
  color: #999;
  font-size: 22rpx;
  white-space: nowrap;
}
.rating-row-arrow {
  color: #bbb;
  font-size: 38rpx;
}
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.detail-title {
  font-size: 34rpx;
  font-weight: 600;
}
.detail-close {
  color: #999;
  font-size: 48rpx;
  line-height: 1;
}
.detail-label {
  margin: 24rpx 0 12rpx;
  color: #666;
  font-size: 26rpx;
}
.detail-stars {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 40rpx;
}
.star-on { color: #ffb400; }
.star-off { color: #ddd; }
.score-text {
  margin-left: 12rpx;
  color: #333;
  font-size: 28rpx;
}
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.detail-tag {
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #f0f8f3;
  color: #07a653;
  font-size: 24rpx;
}
.detail-empty,
.detail-time,
.no-rating {
  color: #999;
  font-size: 26rpx;
}
.detail-comment {
  min-height: 80rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.detail-time {
  margin-top: 24rpx;
  text-align: right;
}
.no-rating {
  padding: 56rpx 0;
  text-align: center;
}
