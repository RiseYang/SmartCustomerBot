<view class="mine-page">
  <view class="profile" bindtap="onProfileTap">
    <image class="avatar" src="{{user.avatarUrl || defaultAvatar}}" mode="aspectFill" />
    <view class="info">
      <text class="name">{{loggedIn ? user.nickName : '未登录'}}</text>
      <text class="sub">{{loggedIn ? (user.phone || '已绑定微信') : '点击登录'}}</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="go" data-url="/pages/order/order">我的订单</view>
    <view class="menu-item" bindtap="goChat">联系客服</view>
    <view class="menu-item" bindtap="rate">服务评价</view>
  </view>

  <button wx:if="{{loggedIn}}" class="logout" bindtap="onLogout">退出登录</button>
</view>

<view wx:if="{{showRateList}}" class="detail-mask" bindtap="closeRateList">
  <view class="detail-sheet list-sheet" catchtap="preventTap">
    <view class="detail-header">
      <text class="detail-title">服务评价</text>
      <text class="detail-close" bindtap="closeRateList">×</text>
    </view>
    <view wx:if="{{satisfactionList.length}}" class="rating-list">
      <view wx:for="{{satisfactionList}}" wx:key="id" class="rating-row" data-index="{{index}}" bindtap="openRateDetail">
        <view class="rating-row-main">
          <view class="rating-row-title">服务评价 · {{item.score}} 分</view>
          <view class="rating-row-preview">{{item.comment || '查看评价详情'}}</view>
        </view>
        <view class="rating-row-meta">
          <text class="rating-row-time">{{item.createdAt}}</text>
          <text class="rating-row-arrow">›</text>
        </view>
      </view>
    </view>
    <view wx:else class="no-rating">暂无服务评价记录</view>
  </view>
</view>

<view wx:if="{{showRateDetail}}" class="detail-mask detail-top" bindtap="closeRateDetail">
  <view class="detail-sheet" catchtap="preventTap">
    <view class="detail-header">
      <text class="detail-title">服务评价详情</text>
      <text class="detail-close" bindtap="closeRateDetail">×</text>
    </view>
    <view wx:if="{{satisfaction}}">
      <view class="detail-label">服务评分</view>
      <view class="detail-stars">
        <text wx:for="{{starList}}" wx:key="*this" class="{{item <= satisfaction.score ? 'star-on' : 'star-off'}}">★</text>
        <text class="score-text">{{satisfaction.score}} 分</text>
      </view>
      <view class="detail-label">评价标签</view>
      <view class="detail-tags">
        <text wx:for="{{satisfaction.tags}}" wx:key="*this" class="detail-tag">{{item}}</text>
        <text wx:if="{{!satisfaction.tags || !satisfaction.tags.length}}" class="detail-empty">未选择标签</text>
      </view>
      <view class="detail-label">评价内容</view>
      <view class="detail-comment">{{satisfaction.comment || '未填写评价内容'}}</view>
      <view class="detail-time">评价时间：{{satisfaction.createdAt}}</view>
    </view>
    <view wx:else class="no-rating">暂无服务评价记录</view>
  </view>
</view>
