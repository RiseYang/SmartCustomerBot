.page {
  padding: 32rpx;
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}
.hero {
  background: linear-gradient(135deg, #07c160 0%, #06ae56 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  color: #fff;
  margin-bottom: 40rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}
.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin: 16rpx 0 32rpx;
}
.chat-entry {
  background: #fff !important;
  color: #07c160 !important;
  font-weight: 600;
  border-radius: 999rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.grid-item .icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.features {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.feat {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #555;
}
.feat:last-child {
  border-bottom: none;
}
