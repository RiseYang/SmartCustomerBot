<view class="biz-page">
  <view class="form">
    <view class="field">
      <text class="label">订单号 *</text>
      <input class="input" value="{{form.orderId}}" data-key="orderId" bindinput="onField" />
    </view>
    <view class="field">
      <text class="label">类型 *</text>
      <radio-group bindchange="onReturnType">
        <label class="radio"><radio value="return" checked="{{form.type==='return'}}" />退货</label>
        <label class="radio"><radio value="exchange" checked="{{form.type==='exchange'}}" />换货</label>
      </radio-group>
    </view>
    <view class="field">
      <text class="label">原因 *</text>
      <textarea class="textarea" value="{{form.reason}}" data-key="reason" bindinput="onField" placeholder="请描述问题"></textarea>
    </view>
    <view class="field">
      <text class="label">凭证图片</text>
      <view class="imgs">
        <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="thumb" />
        <view class="add" bindtap="addImage">+</view>
      </view>
    </view>
    <button type="primary" loading="{{loading}}" bindtap="submit">提交申请</button>
  </view>
</view>
