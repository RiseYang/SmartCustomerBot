.biz-page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f7f9;
}
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
}
.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.radio {
  margin-right: 32rpx;
  font-size: 28rpx;
}
.imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.thumb,
.add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}
.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
}
