.biz-page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f7f9;
}
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input,
.picker {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
