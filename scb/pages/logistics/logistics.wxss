.biz-page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f7f9;
}
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search {
  flex: 1;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.error {
  color: #e64340;
  text-align: center;
  padding: 40rpx;
}
.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.line {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.k {
  color: #888;
  margin-right: 16rpx;
}
.timeline {
  margin-top: 32rpx;
  border-left: 2rpx solid #e0e0e0;
  padding-left: 24rpx;
}
.trace {
  position: relative;
  padding-bottom: 32rpx;
}
.dot {
  position: absolute;
  left: -31rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #07c160;
  border-radius: 50%;
}
.time {
  display: block;
  font-size: 24rpx;
  color: #999;
}
.desc {
  font-size: 28rpx;
  color: #333;
}
