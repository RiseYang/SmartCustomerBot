.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.stars {
  text-align: center;
  margin-bottom: 24rpx;
}
.star {
  font-size: 56rpx;
  color: #ddd;
  margin: 0 8rpx;
}
.star.on {
  color: #ffb800;
}
.comment {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}
.tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #666;
}
.tag.on {
  background: #e6f7ef;
  color: #07c160;
}
.actions {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}
.actions button {
  flex: 1;
}
