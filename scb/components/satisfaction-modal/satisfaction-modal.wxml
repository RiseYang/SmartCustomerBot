<view class="mask" wx:if="{{visible}}" catchtouchmove="preventMove">
  <view class="sheet">
    <view class="title">本次服务满意吗？</view>
    <view class="stars">
      <text
        wx:for="{{5}}"
        wx:key="*this"
        class="star {{score >= item ? 'on' : ''}}"
        data-score="{{item}}"
        bindtap="onStar"
      >★</text>
    </view>
    <textarea
      class="comment"
      placeholder="留言或质检反馈（选填）"
      maxlength="500"
      value="{{comment}}"
      bindinput="onComment"
    />
    <view class="tags">
      <text
        wx:for="{{tagOptions}}"
        wx:key="*this"
        class="tag {{tags.indexOf(item) >= 0 ? 'on' : ''}}"
        data-tag="{{item}}"
        bindtap="onTag"
      >{{item}}</text>
    </view>
    <view class="actions">
      <button size="mini" bindtap="onSkip">稍后</button>
      <button size="mini" type="primary" bindtap="onSubmit">提交评价</button>
    </view>
  </view>
</view>
