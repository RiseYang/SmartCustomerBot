.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  align-items: flex-start;
}
.from-user {
  flex-direction: row-reverse;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e8f4ff;
}
.from-user .avatar.user {
  background: #ddd;
}
.bubble-wrap {
  max-width: 75%;
  margin: 0 16rpx;
}
.bubble {
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.from-bot .bubble {
  background: #fff;
  color: #333;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.from-user .bubble {
  background: #07c160;
  color: #fff;
}
.bubble.system {
  background: #fff7e6;
  color: #ad6800;
  font-size: 26rpx;
}
.msg-image {
  width: 100%;
  max-width: 400rpx;
  border-radius: 8rpx;
}
.msg-video {
  width: 100%;
  max-width: 420rpx;
}
.card-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.card-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
}
.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
}
.quick-btn {
  margin: 0;
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
}
.form-panel .form-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}
.form-field {
  margin-bottom: 16rpx;
}
.form-field .label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.form-field .input {
  background: #f5f5f5;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.submit-form {
  margin-top: 8rpx;
}
